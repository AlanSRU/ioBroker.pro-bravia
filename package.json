{
  "name": "iobroker.pro-bravia",
  "version": "0.0.1",
  "description": "Control and monitor Sony BRAVIA Professional Displays via REST API, Simple IP Control, IRCC-IP and Wake-on-LAN",
  "author": {
    "name": "Alan Paris",
    "email": "alan.paris@scottish.rugby"
  },
  "homepage": "https://github.com/AlanSRU/ioBroker.pro-bravia",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "sony",
    "bravia",
    "professional display",
    "digital signage",
    "ssip",
    "ircc",
    "av"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AlanSRU/ioBroker.pro-bravia.git"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE"
  ],
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.1",
    "axios": "^1.7.9"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.2.0",
    "@iobroker/testing": "^5.2.2",
    "@iobroker/types": "^7.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~7.0.2",
    "@tsconfig/node22": "^22.0.0"
  },
  "scripts": {
    "prebuild": "rimraf build",
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test": "jest && npm run test:package",
    "test:watch": "jest --watch",
    "test:package": "mocha test/package.js --exit",
    "check": "tsc --noEmit",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script",
    "test:integration": "mocha test/integration.js --exit"
  },
  "bugs": {
    "url": "https://github.com/AlanSRU/ioBroker.pro-bravia/issues"
  },
  "readmeFilename": "README.md"
}
